#!/bin/bash
set -u

INSTALL_DIR="/Applications/PlexCurator"
CONSOLE_USER="$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || true)"

if [[ -z "$CONSOLE_USER" || "$CONSOLE_USER" == "root" || "$CONSOLE_USER" == "loginwindow" ]]; then
  exit 0
fi

USER_UID="$(/usr/bin/id -u "$CONSOLE_USER" 2>/dev/null || true)"
if [[ -z "$USER_UID" ]]; then
  exit 0
fi

run_as_user() {
  /bin/launchctl asuser "$USER_UID" /usr/bin/sudo -u "$CONSOLE_USER" -H "$@"
}

# An upgrade must not overwrite an existing installation if its state
# could not be backed up. The backend backup includes config, station/schedule
# definitions, presets, and the SQLite state database.
if [[ -x "$INSTALL_DIR/plex-curator" ]]; then
  STAMP="$(/bin/date +%Y%m%d-%H%M%S)"
  BACKUP_OUTPUT="$(run_as_user "$INSTALL_DIR/plex-curator" backup --reason "pre-pkg-$STAMP" 2>&1)"
  BACKUP_STATUS=$?
  if [[ "$BACKUP_STATUS" -ne 0 ]]; then
    echo "ERROR: Plex Curator could not back up existing data. Installation stopped to protect your settings." >&2
    echo "Open the existing Plex Curator app and check available disk space and configuration-folder permissions, then retry." >&2
    exit 1
  fi
  case "$BACKUP_OUTPUT" in
    "Backup created: "*)
      BACKUP_PATH="${BACKUP_OUTPUT#Backup created: }"
      if [[ ! -f "$BACKUP_PATH/manifest.json" ]]; then
        echo "ERROR: Plex Curator backup manifest is missing; installation stopped." >&2
        exit 1
      fi
      echo "Existing Plex Curator data backed up successfully."
      ;;
    *)
      echo "ERROR: Plex Curator backup did not confirm success; installation stopped." >&2
      exit 1
      ;;
  esac
fi

# Older installers may have left obsolete Plex Curator LaunchAgents behind.
# If the installed manager already knows how to clean them, do so before
# replacing the backend. The new postinstall reconciles again afterward.
if [[ -x "$INSTALL_DIR/plex-curator-launchd" ]]; then
  run_as_user "$INSTALL_DIR/plex-curator-launchd" cleanup-stale >/dev/null 2>&1 || true
fi

exit 0
