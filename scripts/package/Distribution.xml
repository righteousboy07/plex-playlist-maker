<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Plex Curator</title>
    <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
    <volume-check script="true">
        <allowed-os-versions>
            <os-version min="12.0"/>
        </allowed-os-versions>
    </volume-check>
    <options customize="allow" require-scripts="false"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <readme file="readme.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <choices-outline>
        <line choice="app"/>
        <line choice="backend"/>
    </choices-outline>

    <choice
        id="app"
        visible="true"
        start_selected="true"
        title="Plex Curator App"
        description="Install or update the Plex Curator macOS application.">
        <pkg-ref id="com.ry.plexcurator.app.component"/>
    </choice>

    <choice
        id="backend"
        visible="true"
        start_selected="true"
        title="API Backend &amp; Automation"
        description="Install or update the local API backend, command-line engine, examples, and LaunchAgent automation tools.">
        <pkg-ref id="com.ry.plexcurator.backend.component"/>
    </choice>

    <pkg-ref id="com.ry.plexcurator.app.component">PlexCuratorApp.pkg</pkg-ref>
    <pkg-ref id="com.ry.plexcurator.app.component">
        <must-close>
            <app id="com.ry.plexcurator.mac"/>
        </must-close>
    </pkg-ref>

    <pkg-ref id="com.ry.plexcurator.backend.component" auth="root">PlexCuratorBackend.pkg</pkg-ref>
</installer-gui-script>
