#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

APP_DIR = Path(__file__).resolve().parent
VENV_PYTHON = APP_DIR / ".venv" / "bin" / "python"

if VENV_PYTHON.exists():
    current = Path(sys.executable).resolve()
    target = VENV_PYTHON.resolve()
    if current != target:
        os.execv(str(target), [str(target), str(Path(__file__).resolve()), *sys.argv[1:]])
import urllib.error
import urllib.request

from plex_curator_api import API_KEY_FILE, ensure_api_key

DEFAULT_PORT = 8765

def cmd_serve(args):
    ensure_api_key()
    import uvicorn
    uvicorn.run(
        "plex_curator_api:app",
        host="127.0.0.1",
        port=args.port,
        reload=False,
        workers=1,
        access_log=not args.no_access_log,
    )

def cmd_key(_args):
    print(ensure_api_key())

def cmd_key_path(_args):
    ensure_api_key()
    print(API_KEY_FILE)

def cmd_ping(args):
    url = f"http://127.0.0.1:{args.port}/api/v1/ping"
    try:
        with urllib.request.urlopen(url, timeout=3) as response:
            print(json.dumps(json.load(response), indent=2))
    except Exception as exc:
        print(f"API unavailable: {exc}", file=sys.stderr)
        raise SystemExit(1)

def main():
    ap = argparse.ArgumentParser(prog="plex-curator-api")
    sp = ap.add_subparsers(dest="cmd", required=True)

    p = sp.add_parser("serve", help="Run the localhost-only Plex Curator API.")
    p.add_argument("--port", type=int, default=DEFAULT_PORT)
    p.add_argument("--no-access-log", action="store_true")
    p.set_defaults(func=cmd_serve)

    p = sp.add_parser("key", help="Print the local API key.")
    p.set_defaults(func=cmd_key)

    p = sp.add_parser("key-path", help="Print the local API key file path.")
    p.set_defaults(func=cmd_key_path)

    p = sp.add_parser("ping", help="Check whether the local API is responding.")
    p.add_argument("--port", type=int, default=DEFAULT_PORT)
    p.set_defaults(func=cmd_ping)

    args = ap.parse_args()
    args.func(args)

if __name__ == "__main__":
    main()
